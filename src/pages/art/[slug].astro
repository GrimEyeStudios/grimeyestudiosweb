---
import Base from '../../layouts/Base.astro';
import ArtGrid from '../../components/ArtGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
import { universes } from '../../lib/art';

export function getStaticPaths() {
  return universes.map((u) => ({ params: { slug: u.slug }, props: { universe: u } }));
}

const { universe } = Astro.props;
const i = universes.findIndex((u) => u.slug === universe.slug);
const prev = universes[i - 1];
const next = universes[i + 1];
---

<Base
  title={universe.title}
  description={universe.description ?? `${universe.title} — art by Grimeye Studios`}
>
  <nav class="crumbs" aria-label="Breadcrumb">
    <a href="/">Art</a>
    <span aria-hidden="true">/</span>
    <span>{universe.title}</span>
  </nav>

  <header class="page-head">
    <p class="kicker">Universe · {universe.pieces.length} pieces</p>
    <h1>{universe.title}</h1>
    {universe.description && <p>{universe.description}</p>}
  </header>

  {universe.story.length > 0 && (
    <section class="story card">
      <h2>{universe.storyTitle}</h2>
      {universe.story.map((p) => (
        <p>{p}</p>
      ))}
    </section>
  )}

  <ArtGrid pieces={universe.pieces} group={universe.slug} />

  <nav class="pager" aria-label="Other universes">
    {prev ? (
      <a href={`/art/${prev.slug}/`} class="btn">
        ‹ {prev.title}
      </a>
    ) : (
      <span />
    )}
    {next ? (
      <a href={`/art/${next.slug}/`} class="btn">
        {next.title} ›
      </a>
    ) : (
      <span />
    )}
  </nav>

  <Lightbox />
</Base>

<style>
  .story {
    padding: 22px 26px 12px;
    margin-bottom: 32px;
    max-width: 75ch;
    border-left: 3px solid var(--red);
  }
  .story:hover {
    border-color: var(--line);
    border-left-color: var(--red);
    box-shadow: none;
  }
  .story h2 {
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--red-bright);
    margin-bottom: 0.9em;
  }
  .story p {
    color: var(--text);
    line-height: 1.7;
  }
  .crumbs {
    display: flex;
    gap: 10px;
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .crumbs a:hover {
    color: var(--red-bright);
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin-top: 40px;
  }
</style>
