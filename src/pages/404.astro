---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <section class="nf">
    <p class="kicker">404</p>
    <h1>Nothing here.</h1>
    <p class="muted">The page you're looking for doesn't exist or has moved.</p>
    <a href="/" class="btn btn-primary">
      Back to the art
    </a>
  </section>
</Base>

<style>
  .nf {
    text-align: center;
    padding: 64px 0;
  }
</style>
