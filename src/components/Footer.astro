---
import { site } from '../site.config';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-inner">
    <span class="muted">
      © {year} {site.name} · {site.owner}
    </span>
    <ul class="links">
      {site.socials.map((s) => (
        <li>
          <a href={s.href} target="_blank" rel="noopener noreferrer">
            {s.label}
          </a>
        </li>
      ))}
      <li>
        <a href={`mailto:${site.email}`}>Email</a>
      </li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    font-size: 0.85rem;
  }
  .footer-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 20px var(--gutter);
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    align-items: center;
    justify-content: space-between;
  }
  .links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 18px;
  }
  .links a {
    color: var(--muted);
    transition: color 0.15s;
  }
  .links a:hover {
    color: var(--red-bright);
  }
</style>
