---
import { Image } from 'astro:assets';
import { site } from '../site.config';
import logo from '../assets/brand/logo.png';

const tabs = [
  { href: '/', label: 'Art', match: (p: string) => p === '/' || p.startsWith('/art') },
  { href: '/games', label: 'Games' },
  { href: '/playlist-converter', label: 'Playlist Converter' },
  { href: '/playlist-splitter', label: 'Playlist Splitter' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (t: (typeof tabs)[number]) =>
  t.match ? t.match(path) : path === t.href || path.startsWith(t.href + '/');
---

<header class="nav">
  <div class="nav-inner">
    <a href="/" class="brand" aria-label={`${site.name} home`}>
      <Image src={logo} alt="" width={40} height={40} densities={[1, 2]} class="brand-logo" />
      <span class="brand-name">{site.name}</span>
    </a>
    <nav aria-label="Primary">
      <ul class="tabs">
        {tabs.map((t) => (
          <li>
            <a href={t.href} aria-current={isActive(t) ? 'page' : undefined}>
              {t.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(10 10 12 / 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 var(--gutter);
    display: flex;
    align-items: center;
    gap: 24px;
    min-height: var(--nav-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
  }
  .brand-logo {
    width: 40px;
    height: 40px;
    object-fit: contain;
    filter: drop-shadow(0 0 6px rgb(255 31 43 / 0.5));
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  nav {
    margin-left: auto;
    min-width: 0;
  }
  .tabs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .tabs::-webkit-scrollbar {
    display: none;
  }
  .tabs a {
    position: relative;
    display: block;
    padding: 22px 12px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    transition: color 0.15s;
  }
  .tabs a:hover {
    color: var(--text);
  }
  .tabs a[aria-current='page'] {
    color: var(--text);
  }
  .tabs a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 0;
    height: 2px;
    background: var(--red-bright);
    box-shadow: 0 0 10px var(--red-bright);
  }

  /* Phone: brand + a horizontally scrolling tab row on its own line. */
  @media (max-width: 719px) {
    .nav-inner {
      flex-wrap: wrap;
      gap: 0;
      padding-top: 10px;
    }
    .brand-name {
      font-size: 0.95rem;
    }
    nav {
      flex-basis: 100%;
      margin-left: calc(-1 * var(--gutter));
      margin-right: calc(-1 * var(--gutter));
      padding: 0 var(--gutter);
    }
    .tabs a {
      padding: 12px 10px 14px;
    }
    /* Fade the right edge so it's obvious the tab row scrolls. */
    .tabs {
      mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
      -webkit-mask-image: linear-gradient(to right, #000 calc(100% - 40px), transparent);
    }
  }
</style>
